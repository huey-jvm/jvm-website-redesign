# Copy to .env.local for development. On Vercel, set these per environment.

# Public URL of the site, used for canonical links, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.jvmsolutions.net

# Show the placeholder blocks (dashed gold boxes with a register id). Development shows them automatically.
# Set to "true" on the Vercel Preview environment and leave unset on Production.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=

# Set to "true" on Preview so search engines do not index preview deployments.
NEXT_PUBLIC_NOINDEX=

# Contact form delivery (Resend). Without a key, development logs the message and production returns
# a "not configured" error that the form shows with a direct email fallback.
RESEND_API_KEY=
CONTACT_FROM="JVM Solutions <no-reply@jvmsolutions.net>"

# Spam protection (Cloudflare Turnstile). Both optional. Without them the honeypot alone applies.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
