{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-pages.mjs out 3200 --http2",
      "url": [
        "https://localhost:3200/",
        "https://localhost:3200/services/healthcare-operations/",
        "https://localhost:3200/contracting/",
        "https://localhost:3200/careers/"
      ],
      "settings": {
        "chromeFlags": "--ignore-certificate-errors --allow-insecure-localhost"
      },
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}
