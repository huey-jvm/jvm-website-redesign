{
  "name": "jvm-solutions-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "images:prepare": "node scripts/prepare-images.mjs",
    "dev": "node scripts/prepare-images.mjs && next dev",
    "build": "node scripts/prepare-images.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:gates": "playwright test tests/e2e/width-sweep.spec.ts tests/e2e/structure.spec.ts tests/e2e/a11y.spec.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "lighthouse:mobile": "lhci collect && lhci assert",
    "lighthouse:desktop": "lhci collect --settings.preset=desktop && lhci assert"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0"
}
